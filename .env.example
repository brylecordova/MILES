# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for courses, learners, submissions, and certificates.
# When omitted in local/preview mode, CertiField automatically persists to .data/certify_db.json.
MONGODB_URI=

# ADMIN_PASSCODE: Passcode for the Admin Course Studio.
# When unset, the Admin Studio shows a one-time first-run setup form to claim the admin password.
ADMIN_PASSCODE=

# Optional SMTP configuration for emailing PDF certificates directly from the server.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
